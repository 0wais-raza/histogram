rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ════════════════════════════════════════
    // Users collection
    // ════════════════════════════════════════
    match /users/{uid} {
      // Anyone authenticated can read user profiles
      allow read: if request.auth != null;
      // Only the user can create their own profile
      allow create: if request.auth != null && request.auth.uid == uid;
      // Owner can update their profile; others can ONLY update follower/following counts
      allow update: if request.auth != null && (
        request.auth.uid == uid
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount', 'followingCount'])
      );
      // Only the user can delete their own profile
      allow delete: if request.auth != null && request.auth.uid == uid;

      // Chat threads subcollection
      match /chatThreads/{threadId} {
        allow read: if request.auth != null;
        // Allow the thread owner OR the other chat participant to write.
        // threadId is the chatId format "{uid1}_{uid2}" (sorted).
        // Check both orderings since chatId is sorted.
        allow write: if request.auth != null
                    && (
                      request.auth.uid == uid
                      || threadId in [uid + "_" + request.auth.uid, request.auth.uid + "_" + uid]
                    );
      }
    }

    // ════════════════════════════════════════
    // Usernames collection
    // ════════════════════════════════════════
    match /usernames/{username} {
      allow read: if true;
      // Create: any authenticated user can reserve a username
      allow create: if request.auth != null;
      // Update: only allow claiming — doc must be in "pending" state and the claimant must set uid to themselves
      allow update: if request.auth != null
                    && resource.data.status == "pending"
                    && request.resource.data.uid == request.auth.uid;
      // Delete: allow cleanup of pending usernames, or owner deleting their own
      allow delete: if request.auth != null
                    && (resource.data.status == "pending"
                        || resource.data.uid == request.auth.uid);
    }

    // ════════════════════════════════════════
    // Follows collection
    // ════════════════════════════════════════
    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.followerId;
      // Allow either party to delete (unfollow or remove follower during account deletion)
      allow delete: if request.auth != null
                    && (request.auth.uid == resource.data.followerId
                        || request.auth.uid == resource.data.followingId);
      allow update: if false;
    }

    // ════════════════════════════════════════
    // Posts collection
    // ════════════════════════════════════════
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.authorId;
      // Owner can update anything; others can ONLY update likesCount
      allow update: if request.auth != null && (
        request.auth.uid == resource.data.authorId
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount'])
      );
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.authorId;

      // Comments subcollection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
                      && (request.auth.uid == resource.data.authorId
                          || get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid);
        // Allow any authenticated user to update likesCount on comments
        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount']);
      }
    }

    // ════════════════════════════════════════
    // Post Likes
    // ════════════════════════════════════════
    match /postLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ════════════════════════════════════════
    // Post Saves (Bookmarks)
    // ════════════════════════════════════════
    match /postSaves/{saveId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ════════════════════════════════════════
    // Comment Likes
    // ════════════════════════════════════════
    match /commentLikes/{likeId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow delete: if request.auth != null
                    && request.auth.uid == resource.data.userId;
      allow update: if false;
    }

    // ════════════════════════════════════════
    // Chats
    // ════════════════════════════════════════
    match /chats/{chatId} {
      allow read: if request.auth != null
                  && request.auth.uid in resource.data.participants;
      allow create: if request.auth != null
                    && request.auth.uid in request.resource.data.participants;
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }

    // ════════════════════════════════════════
    // User Status (online/offline presence)
    // ════════════════════════════════════════
    match /userStatus/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
